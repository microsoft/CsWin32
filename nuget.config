<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="repositorypath" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- These test-helper previews are not published on nuget.org. -->
    <add key="msft_consumption" value="https://pkgs.dev.azure.com/azure-public/vside/_packaging/msft_consumption/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="msft_consumption">
      <package pattern="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.XUnit" />
      <package pattern="Microsoft.CodeAnalysis.Analyzer.Testing" />
      <package pattern="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" />
      <package pattern="Microsoft.CodeAnalysis.SourceGenerators.Testing" />
      <package pattern="Microsoft.CodeAnalysis.Testing.Verifiers.XUnit" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <!-- Defend against user or machine level disabling of sources that we list in this file. -->
    <clear />
  </disabledPackageSources>
</configuration>
