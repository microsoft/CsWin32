// Source for SelfContained.winmd.
//
// Reproduces the OSClient CsWin32 build configuration: a non-Windows.Win32 metadata assembly (common
// namespace "SelfContained") generated by a *single* Generator -- i.e. with NO SuperGenerator / Windows.Win32
// generator to delegate to -- while the Windows.Win32 projection is provided by a *referenced assembly*.
//
// In that configuration CsWin32 cannot emit the special string typedefs (PCWSTR, etc.) itself and there is no
// Windows.Win32 generator to delegate their emission to, so they must be referenced under
// Windows.Win32.Foundation (where the referenced projection provides them). Previously CsWin32 referenced them
// under the consuming assembly's own root namespace (e.g. SelfContained.Foundation.PCWSTR /
// OSClient.Foundation.PCWSTR), which does not exist and fails to compile with:
//     error CS0234: The type or namespace name 'Foundation' does not exist in the namespace 'SelfContained'
//
// PWSTR is defined locally (as the OSClient WinMD carries its own Foundation types); CsWin32 synthesizes the
// const PCWSTR from it. Two P/Invoke methods exercise both places the mis-qualification appeared:
//   * Foo: a [Const] PWSTR* (no count) -> projected as a single "in PCWSTR" (the element type).
//   * Bar: a [Const, NativeArrayInfo] PWSTR* (counted) -> ReadOnlySpan<string> + ArrayPool<PCWSTR>.

.assembly extern netstandard { .publickeytoken = (CC 7B 13 FF CD 2D DD 51 ) .ver 2:1:0:0 }
.assembly extern Windows.Win32.winmd { .ver 0:0:0:0 }
.assembly SelfContained { .ver 1:0:0:0 }
.module SelfContained.winmd
.module extern somedll.dll
.corflags 0x00000001

.class public sequential ansi sealed beforefieldinit SelfContained.Foundation.PWSTR
       extends [netstandard]System.ValueType
{
  .custom instance void [Windows.Win32.winmd]Windows.Win32.Foundation.Metadata.NativeTypedefAttribute::.ctor() = ( 01 00 00 00 )
  .field public char* Value
}

.class public abstract auto autochar sealed beforefieldinit SelfContained.Apis
       extends [netstandard]System.Object
{
  .method public hidebysig static pinvokeimpl("somedll.dll" nomangle winapi)
          void Foo([in] valuetype SelfContained.Foundation.PWSTR* p) cil managed
  {
    .param [1]
    .custom instance void [Windows.Win32.winmd]Windows.Win32.Foundation.Metadata.ConstAttribute::.ctor() = ( 01 00 00 00 )
  }

  .method public hidebysig static pinvokeimpl("somedll.dll" nomangle winapi)
          void Bar([in] valuetype SelfContained.Foundation.PWSTR* p, uint32 c) cil managed
  {
    .param [1]
    .custom instance void [Windows.Win32.winmd]Windows.Win32.Foundation.Metadata.ConstAttribute::.ctor() = ( 01 00 00 00 )
    .custom instance void [Windows.Win32.winmd]Windows.Win32.Foundation.Metadata.NativeArrayInfoAttribute::.ctor() = ( 01 00 01 00 53 06 0F 43 6F 75 6E 74 50 61 72 61 6D 49 6E 64 65 78 01 00 )
  }
}
