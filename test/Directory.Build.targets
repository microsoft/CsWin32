<?xml version="1.0" encoding="utf-8"?>
<Project>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('xunit.runner.json')" />
  </ItemGroup>

  <Target Name="CopyProjectionMetadataToTestOutput" AfterTargets="PrepareForBuild">
    <ItemGroup>
      <None Include="@(ProjectionMetadataWinmd)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)..))" />
</Project>
